{
  "name": "colerm-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3990",
    "build": "pnpm generate:og && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3990",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate:og": "node scripts/generate-og.mjs",
    "deploy": "pnpm build && pnpm exec wrangler deploy",
    "deploy:dry-run": "pnpm build && pnpm exec wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@vercel/og": "^0.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "4.45.2"
  },
  "dependencies": {
    "@wterm/dom": "0.2.1",
    "@wterm/just-bash": "0.2.1",
    "just-bash": "^2.14.5"
  }
}
