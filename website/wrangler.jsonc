{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "colerm-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "colerm.com",
      "custom_domain": true
    }
  ]
}
